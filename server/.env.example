PORT=4000
HOST=0.0.0.0

# Optional. Leave unset so the API echoes the browser Origin (typical for Render: separate UI + API).
# If you set this to ONLY http://localhost:5173, production UI on another domain will get "Failed to fetch".
# Use a comma-separated list to allow local + prod:
# CORS_ORIGIN=http://localhost:5173,https://your-web-service.onrender.com
