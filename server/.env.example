# Local Postgres (default schema).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/impact?schema=public"
#
# Neon / serverless Postgres: keep Prisma’s pool small so ingest + API do not exhaust connections.
# Append to the query string (merge with existing ?/&):
#   ?pgbouncer=true&connect_timeout=15&connection_limit=3
# or (direct driver pool cap):
#   ?connection_limit=5
# Docs: https://pris.ly/d/connection-pool  https://www.prisma.io/docs/guides/database/neon
PORT=4000
HOST=0.0.0.0

# Optional. Leave unset so the API echoes the browser Origin (typical for Render: separate UI + API).
# If you set this to ONLY http://localhost:5173, production UI on another domain will get "Failed to fetch".
# Use a comma-separated list to allow local + prod:
# CORS_ORIGIN=http://localhost:5173,https://your-web-service.onrender.com

# Required for `npm run ingest:github` (Bearer token on all GitHub API requests). Also accepted: GH_TOKEN.
# GITHUB_TOKEN=ghp_...
